NODE_ENV=production
HOST=127.0.0.1
PORT=3100
# 无域名 HTTP 测试时留空，应用按 Nginx Host 自动校验同源。
# 有域名时填写：https://rabbit.example.com
PUBLIC_ORIGIN=
SESSION_SECRET=replace-with-at-least-32-random-characters
COOKIE_SECURE=false
DATABASE_PATH=/opt/rabbit-home/data/rabbit-home.db
HOME_MAX_PLAYERS=8
ALLOW_REGISTRATION=true
REGISTRATION_CODE=
BACKUP_DIR=/opt/rabbit-home/backups
BACKUP_RETENTION_DAYS=14
